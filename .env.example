# Copy this file to .env.local and fill in real values.
# Never commit .env.local or real credentials to version control.

# Contact form — sent via Resend (https://resend.com). Get an API key from
# the Resend dashboard. See src/app/api/contact/route.ts for the handler.
RESEND_API_KEY=

# Where contact form submissions are delivered. Until you verify a custom
# domain with Resend, this MUST be the email address on your Resend account
# — Resend only allows the onboarding@resend.dev sender to deliver to the
# account owner's own address.
CONTACT_EMAIL_TO=

# Optional. Defaults to "Portfolio Contact <onboarding@resend.dev>". Set this
# once you've verified a domain in Resend, e.g. "Abass <hello@yourdomain.com>".
CONTACT_EMAIL_FROM=
